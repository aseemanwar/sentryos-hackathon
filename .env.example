# Sentry Configuration
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# Sentry Organization Slug (for source map uploads)
SENTRY_ORG=your-org-slug

# Sentry Project Name (for source map uploads)
SENTRY_PROJECT=your-project-name

# Sentry Auth Token (for source map uploads)
# Create one at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-auth-token
